{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Capabilities of the TruongPaper Studio window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "autostart:default",
    "updater:default",
    "process:allow-restart",
    "shell:default",
    "shell:allow-open",
    "allow-photo-get-status",
    "allow-photo-fetch-public-catalog",
    "allow-photo-rotate-next",
    "allow-photo-trigger-refill",
    "allow-photo-add-album",
    "allow-photo-toggle-album",
    "allow-photo-remove-album",
    "allow-photo-set-filter",
    "allow-photo-set-favorite",
    "allow-photo-apply-favorite",
    "allow-photo-blacklist-and-skip",
    "allow-photo-set-cache-limit",
    "allow-photo-clear-cache",
    "allow-photo-reset-history",
    "allow-steam-browse-workshop",
    "allow-steam-inspect-url",
    "allow-steam-download-workshop-item",
    "allow-steam-login-qr",
    "allow-steam-login-credentials",
    "allow-steam-submit-2fa-code",
    "allow-steam-logout",
    "allow-steam-cancel-login",
    "allow-steam-account",
    "allow-steam-sync-local-folders",
    "allow-library-list-wallpapers",
    "allow-library-delete-wallpaper",
    "allow-monitors-list",
    "allow-monitor-apply-wallpaper",
    "allow-wallpaper-set-lock-screen",
    "allow-monitor-update-property",
    "allow-monitor-update-adjustments",
    "allow-wallpaper-save-preset",
    "allow-wallpaper-apply-preset",
    "allow-playback-set-paused",
    "allow-monitor-set-volume",
    "allow-playlist-list",
    "allow-playlist-save",
    "allow-settings-get",
    "allow-settings-update",
    "allow-update-feed-status",
    "allow-runtime-shutdown-for-update",
    "allow-runtime-get-memory-usage"
  ]
}
