{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tray",
  "description": "Minimum capabilities of the menu bar popover: quick controls, no library, Steam or update access",
  "windows": [
    "tray-popover"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-unminimize",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "shell:allow-open",
    "allow-photo-get-status",
    "allow-photo-rotate-next",
    "allow-photo-retry-now",
    "allow-photo-set-favorite",
    "allow-photo-blacklist-and-skip",
    "allow-steam-account",
    "allow-library-list-wallpapers",
    "allow-monitors-list",
    "allow-monitor-apply-wallpaper",
    "allow-playback-set-paused",
    "allow-playlist-list",
    "allow-settings-get",
    "allow-settings-update"
  ]
}
